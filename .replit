modules = ["python-3.12", "nodejs-20", "web"]
run = "pip install -r backend/requirements.txt && cd backend && uvicorn main:app --host 0.0.0.0 --port 8000"

[deployment]
build = ["sh", "-c", "pip install -r backend/requirements.txt"]
run = ["sh", "-c", "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 8000
externalPort = 80

[nix]
channel = "stable-25_05"
