# Copy this file to .env and fill in real values.
# Generate a secret key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme-generate-a-random-32-byte-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./medications_db.db

# Optional: allow a deployed frontend (comma-separated origins), e.g. your Lovable site.
# CORS_ORIGINS=https://your-app.lovable.app
# CORS_ORIGIN_REGEX=https://.*\.lovable\.app
# Optional: serve a bundled frontend from the backend (default: API only).
# FRONTEND_DIR=../archive/frontend-vanilla
